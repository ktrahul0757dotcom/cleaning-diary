rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function role() {
      return signedIn() && exists(userPath(request.auth.uid)) ? get(userPath(request.auth.uid)).data.role : 'none';
    }
    function isAdmin()   { return role() == 'admin'; }
    function isSup()     { return role() in ['admin', 'supervisor']; }
    function canRemark() { return role() in ['admin', 'supervisor', 'officer']; }
    function canWork()   { return role() in ['admin', 'supervisor', 'worker']; }
    function isMember()  { return role() in ['admin', 'supervisor', 'officer', 'worker']; }
    function entryPath(id) { return /databases/$(database)/documents/entries/$(id); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // First signed-in user claims admin exactly once.
    match /meta/admin {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/meta/admin)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous' && (
          request.resource.data.role == 'pending' ||
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/meta/admin).data.uid == request.auth.uid));
      // Admin changes roles; users may edit their own profile but never their role.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && onlyKeys(['name', 'phone', 'photoURL']));
      allow delete: if isAdmin() && request.auth.uid != uid;

      match /notifications/{nid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid && onlyKeys(['read']);
        allow create: if canRemark() && request.resource.data.fromUid == request.auth.uid;
      }
    }

    match /places/{id} {
      // Residents (anonymous sign-in) may read a single place to show its name on the feedback form.
      allow get: if signedIn();
      allow list: if isMember();
      allow create, update: if isSup() && validPlace(request.resource.data);
      allow delete: if isSup();
    }
    function optStr(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function validPlace(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && optStr(d, 'area', 120) && optStr(d, 'ward', 120)
        && optStr(d, 'type', 40) && optStr(d, 'typeOther', 60)
        && optStr(d, 'typeLabel', 60) && optStr(d, 'typeIcon', 8);
    }

    // Public jurisdiction banner (office / circle). Anyone may read ONLY this doc; admin writes.
    match /public/banner {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'updatedAt', 'by'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.updatedAt == request.time
        && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Admin-defined extra place types.
    match /meta/placeTypes {
      allow read: if isMember();
      allow write: if isAdmin() && request.resource.data.types is list && request.resource.data.types.size() <= 50;
    }

    // ---------- Resident feedback (public, anonymous auth) ----------
    function feedbackRatePath(rid) { return /databases/$(database)/documents/feedbackRate/$(rid); }
    function canModerate() { return role() in ['admin', 'officer']; }
    function isStaff() { return role() in ['admin', 'supervisor', 'officer']; }

    // One rate doc per (anonymous user, place); a new feedback needs the previous one to be 10+ minutes old.
    match /feedbackRate/{rid} {
      allow read: if signedIn() && rid.matches(request.auth.uid + '_.*');
      allow create, update: if signedIn()
        && rid == request.auth.uid + '_' + request.resource.data.placeId
        && request.resource.data.keys().hasOnly(['placeId', 'last'])
        && request.resource.data.last == request.time
        && (resource == null || resource.data.last < request.time - duration.value(10, 'm'));
      allow delete: if false;
    }

    match /feedback/{fid} {
      allow read: if isStaff();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'area', 'ward', 'rating', 'comment', 'suggestion', 'photo', 'name', 'hasPhone', 'status', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['placeId', 'rating', 'comment', 'status', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.placeId is string
        && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && (!('suggestion' in request.resource.data) || (request.resource.data.suggestion is string && request.resource.data.suggestion.size() <= 1000))
        && (!('placeName' in request.resource.data) || (request.resource.data.placeName is string && request.resource.data.placeName.size() <= 150))
        && (!('area' in request.resource.data) || (request.resource.data.area is string && request.resource.data.area.size() <= 150))
        && (!('ward' in request.resource.data) || (request.resource.data.ward is string && request.resource.data.ward.size() <= 150))
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
              && request.resource.data.photo.size() < 200000 && request.resource.data.photo.matches('data:image/jpeg;base64,.*')))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('hasPhone' in request.resource.data) || request.resource.data.hasPhone is bool)
        && request.resource.data.status == 'visible'
        && request.resource.data.createdAt == request.time
        // must be written together with a fresh rate-limit doc for this user + place
        && getAfter(feedbackRatePath(request.auth.uid + '_' + request.resource.data.placeId)).data.last == request.time;
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['visible', 'hidden'];
      allow delete: if role() == 'admin';

      // Phone numbers live in a separate doc that only admin/officer can read.
      match /private/{doc} {
        allow read: if canModerate();
        allow create: if signedIn() && doc == 'contact'
          && getAfter(/databases/$(database)/documents/feedback/$(fid)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['phone'])
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
        allow update: if false;
        allow delete: if role() == 'admin';
      }
    }

    // ---------- Squad inspection feedback (one-time personal links, anonymous auth) ----------
    // squadLinks/{token}: random unguessable id (>=24 chars). Anyone signed in (anonymous official) may GET by token;
    // only creator (or admin) can list. Never expires unless an admin set expiresAt; single use; creator/admin can revoke.
    // After use, the submitted feedback stays readable (read-only) through the same token, permanently.
    function sqLinkPath(t) { return /databases/$(database)/documents/squadLinks/$(t); }
    function sqFbPath(t) { return /databases/$(database)/documents/squadFeedback/$(t); }
    function sqLinkLive(l) { return l.status == 'open' && (!('expiresAt' in l) || request.time < l.expiresAt); }
    function optStr2(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }

    match /squadLinks/{token} {
      allow get: if signedIn();
      allow list: if isAdmin() || (isStaff() && resource.data.createdBy == request.auth.uid);
      allow create: if isStaff()
        && token.size() >= 24 && token.size() <= 64 && token.matches('[A-Za-z0-9_-]+')
        && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'area', 'ward', 'route', 'inspDate', 'officialName', 'createdBy', 'createdByName', 'createdAt', 'status', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.placeId is string && request.resource.data.placeId.size() <= 60
        && (request.resource.data.placeId == '' || exists(/databases/$(database)/documents/places/$(request.resource.data.placeId)))
        && request.resource.data.placeName is string && request.resource.data.placeName.size() <= 150
        && optStr2(request.resource.data, 'area', 150) && optStr2(request.resource.data, 'ward', 150)
        && optStr2(request.resource.data, 'route', 150) && optStr2(request.resource.data, 'inspDate', 10)
        && optStr2(request.resource.data, 'officialName', 80) && optStr2(request.resource.data, 'createdByName', 80)
        && (request.resource.data.placeId != '' || request.resource.data.get('route', '').size() > 0)
        && (!('expiresAt' in request.resource.data) || (isAdmin() && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time));
      allow update: if
        // creator / admin revokes an open link
        (isStaff() && (resource.data.createdBy == request.auth.uid || isAdmin())
          && resource.data.status == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedBy'])
          && request.resource.data.status == 'revoked'
          && request.resource.data.revokedAt == request.time && request.resource.data.revokedBy == request.auth.uid)
        // official consumes the link together with creating squadFeedback/{token}
        || (signedIn() && sqLinkLive(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'usedBy'])
          && request.resource.data.status == 'used'
          && request.resource.data.usedAt == request.time && request.resource.data.usedBy == request.auth.uid
          && !exists(sqFbPath(token))
          && getAfter(sqFbPath(token)).data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /squadFeedback/{token} {
      // GET by token (the official re-opening their own link sees it read-only); list only for staff. Never editable by the official.
      allow get: if signedIn();
      allow list: if isStaff();
      allow create: if signedIn()
        && exists(sqLinkPath(token)) && sqLinkLive(get(sqLinkPath(token)).data)
        && getAfter(sqLinkPath(token)).data.status == 'used'
        && getAfter(sqLinkPath(token)).data.usedBy == request.auth.uid
        && request.resource.data.keys().hasOnly(['placeId', 'placeName', 'area', 'ward', 'route', 'linkBy', 'linkByName', 'officialName', 'designation', 'institution', 'inspDate', 'overall', 'rating', 'concerns', 'suggestions', 'photo', 'hasPhone', 'status', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['placeId', 'placeName', 'linkBy', 'officialName', 'designation', 'institution', 'inspDate', 'overall', 'rating', 'status', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'visible'
        && request.resource.data.placeId == get(sqLinkPath(token)).data.placeId
        && request.resource.data.placeName == get(sqLinkPath(token)).data.placeName
        && request.resource.data.get('route', '') == get(sqLinkPath(token)).data.get('route', '')
        && request.resource.data.linkBy == get(sqLinkPath(token)).data.createdBy
        && optStr2(request.resource.data, 'area', 150) && optStr2(request.resource.data, 'ward', 150)
        && optStr2(request.resource.data, 'linkByName', 80)
        && request.resource.data.officialName is string && request.resource.data.officialName.size() > 0 && request.resource.data.officialName.size() <= 80
        && request.resource.data.designation is string && request.resource.data.designation.size() > 0 && request.resource.data.designation.size() <= 80
        && request.resource.data.institution is string && request.resource.data.institution.size() > 0 && request.resource.data.institution.size() <= 120
        && request.resource.data.inspDate is string && request.resource.data.inspDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.overall in ['good', 'partial', 'poor']
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && optStr2(request.resource.data, 'concerns', 1500) && optStr2(request.resource.data, 'suggestions', 1500)
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
              && request.resource.data.photo.size() < 200000 && request.resource.data.photo.matches('data:image/jpeg;base64,.*')))
        && (!('hasPhone' in request.resource.data) || request.resource.data.hasPhone is bool);
      allow update: if canModerate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedBy', 'moderatedAt'])
        && request.resource.data.status in ['visible', 'hidden'];
      allow delete: if isAdmin();

      // Official's phone: only admin/officer can read.
      match /private/{doc} {
        allow read: if canModerate();
        allow create: if signedIn() && doc == 'contact'
          && !exists(sqFbPath(token))
          && getAfter(sqFbPath(token)).data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['phone'])
          && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /entries/{id} {
      allow read: if isMember();
      allow create: if canWork() && request.resource.data.workerUid == request.auth.uid
        && request.resource.data.remarkCount == 0;
      allow update: if isSup()
        || (canWork() && resource.data.workerUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['workerUid', 'remarkCount', 'score', 'lastRating', 'lastRemarkAt', 'createdAt']))
        || (canRemark() && onlyKeys(['remarkCount', 'score', 'lastRating', 'lastRemarkAt']));
      allow delete: if isSup() || (canWork() && resource.data.workerUid == request.auth.uid);

      match /photos/{pid} {
        allow read: if isMember();
        allow create: if isSup()
          || (canWork() && getAfter(entryPath(id)).data.workerUid == request.auth.uid
              && (!('data' in request.resource.data) || request.resource.data.data.size() < 400000));
        allow update: if false;
        allow delete: if isSup() || (canWork() && get(entryPath(id)).data.workerUid == request.auth.uid);
      }

      match /remarks/{rid} {
        allow read: if isMember();
        allow create: if canRemark() && request.resource.data.officerUid == request.auth.uid
          && request.resource.data.rating in ['good', 'ok', 'bad'];
        allow update: if signedIn() && resource.data.officerUid == request.auth.uid;
        allow delete: if isSup() || (signedIn() && resource.data.officerUid == request.auth.uid)
          || (canWork() && get(entryPath(id)).data.workerUid == request.auth.uid);
      }
    }
  }
}
